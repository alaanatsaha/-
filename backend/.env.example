# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./pib_assessment.db

# Use production only behind HTTPS and a real authenticated deployment:
# ENVIRONMENT=production
ENVIRONMENT=development

# To move to PostgreSQL later, just change this line (and `pip install psycopg2-binary`):
# DATABASE_URL=postgresql+psycopg2://pib_user:pib_password@localhost:5432/pib_assessment

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# In production, set these to the real HTTPS domain and PostgreSQL connection.
# CORS_ORIGINS=https://credit.example.ps
# ALLOWED_HOSTS=credit.example.ps

# Production example for Neon/Render PostgreSQL:
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
